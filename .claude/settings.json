{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git worktree:*)",
      "Bash(python3:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Edit(client/src/**)",
      "Bash(npm run build:*)",
      "Edit(server/**)",
      "Edit(scripts/**)",
      "Edit(client/README.md)",
      "Bash(openssl:*)",
      "Bash(node:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(aws:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(nc:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Read(//home/ubuntu/.aws/**)",
      "Read(//home/ubuntu/.ssh/**)",
      "Read(//home/ubuntu/.config/**)",
      "Read(//home/ubuntu/.claude/**)",
      "Read(//home/ubuntu/.netrc)",
      "Read(//home/ubuntu/.gitconfig)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/credentials)",
      "Read(//**/credentials.*)",
      "Read(//**/*.pem)",
      "Read(//**/*_rsa)",
      "Read(//**/id_*)",
      "Edit(//home/ubuntu/.aws/**)",
      "Edit(//home/ubuntu/.ssh/**)",
      "Edit(//home/ubuntu/.config/**)",
      "Edit(//home/ubuntu/.claude/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/credentials)",
      "Edit(//**/credentials.*)"
    ],
    "additionalDirectories": []
  }
}